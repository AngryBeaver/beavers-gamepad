<div class="gamepad-config-body">
    {{#unless hasGamepads}}
        <p class="gamepad-notice warning">
            <i class="fa-solid fa-triangle-exclamation"></i>
            {{localize "beaversGamepad.gamepadConfigApp.noGamepad"}}
            {{localize "beaversGamepad.gamepadConfigApp.info"}}
        </p>
    {{/unless}}
    {{#each gamepads as |pad|}}
        <fieldset class="gamepad" data-gamepad="{{pad.index}}">
            <legend>
                <i class="fa-solid fa-gamepad"></i>
                {{pad.gamepadId}} #{{pad.index}}
                {{#if pad.canRumble}}
                    <a data-action="identify" data-gamepad="{{pad.index}}"
                       data-tooltip="beaversGamepad.gamepadConfigApp.identify">
                        <i class="fa-solid fa-mobile-screen-button fa-shake-on-hover"></i>
                    </a>
                {{/if}}
            </legend>
            <p class="hint gamepad-raw" data-tooltip="beaversGamepad.gamepadConfigApp.rawHint"></p>
            <div class="form-group">
                <label>{{localize "beaversGamepad.gamepadConfigApp.user"}}</label>
                <div class="form-fields">
                    <select name="{{pad.index}}.userId">
                        <option value="">{{localize "beaversGamepad.gamepadConfigApp.noUser"}}</option>
                        {{#each pad.users as |user|}}
                            <option value="{{user.id}}" {{#if user.selected}}selected{{/if}}>{{user.name}}</option>
                        {{/each}}
                    </select>
                </div>
                <p class="hint">{{localize "beaversGamepad.gamepadConfigApp.userHint"}}</p>
            </div>
            {{#if pad.userId}}
                <div class="form-group">
                    <label>{{localize "beaversGamepad.uiConfigApp.userPosition"}}</label>
                    <div class="form-fields">
                        <select name="ui.{{pad.userId}}.userPosition">
                            {{selectOptions @root.positionChoices selected=pad.userPosition localize=true}}
                        </select>
                    </div>
                    <p class="hint">{{localize "beaversGamepad.uiConfigApp.userPositionHint"}}</p>
                </div>
            {{/if}}
            {{#each pad.modules as |module|}}
                <fieldset class="gamepad-module">
                    <legend>
                        {{module.name}}
                        {{#if module.bindings.length}}
                            <a data-action="detectAll" data-gamepad="{{pad.index}}" data-module="{{module.id}}"
                               data-tooltip="beaversGamepad.gamepadConfigApp.detectAll">
                                <i class="fa-solid fa-wand-magic-sparkles"></i>
                            </a>
                        {{/if}}
                        <a data-action="deleteModule" data-gamepad="{{pad.index}}" data-module="{{module.id}}"
                           data-tooltip="beaversGamepad.gamepadConfigApp.deleteModule">
                            <i class="fa-solid fa-trash"></i>
                        </a>
                    </legend>
                    {{#if module.isMissing}}
                        <p class="hint">{{localize "beaversGamepad.gamepadConfigApp.missingModule"}}</p>
                    {{else if module.desc}}
                        <p class="hint">{{localize module.desc}}</p>
                    {{/if}}
                    {{#each module.bindings as |binding|}}
                        <div class="form-group binding {{#if binding.listening}}listening{{/if}}"
                             data-kind="{{binding.kind}}">
                            <label>{{binding.label}}</label>
                            <div class="form-fields">
                                <input type="number" class="binding-index" name="{{binding.path}}.index"
                                       value="{{binding.index}}" min="0" step="1"/>
                                {{#if binding.isAxis}}
                                    <label class="checkbox">
                                        <input type="checkbox" name="{{binding.path}}.reversed" {{checked binding.reversed}}/>
                                        {{localize "beaversGamepad.gamepadConfigApp.reversedLabel"}}
                                    </label>
                                {{/if}}
                                <button type="button" class="detect" data-action="detect"
                                        data-gamepad="{{pad.index}}" data-module="{{module.id}}"
                                        data-kind="{{binding.kind}}" data-name="{{binding.name}}">
                                    <i class="fa-solid fa-crosshairs"></i>
                                    {{localize "beaversGamepad.gamepadConfigApp.detect"}}
                                </button>
                            </div>
                            {{#if binding.listening}}
                                <p class="hint capture-prompt">
                                    {{@root.prompt}}
                                    <a data-action="cancelDetect">{{localize "beaversGamepad.detect.cancel"}}</a>
                                </p>
                            {{/if}}
                        </div>
                    {{/each}}
                </fieldset>
            {{/each}}
            {{#if pad.addable.length}}
                <div class="form-group">
                    <label>{{localize "beaversGamepad.gamepadConfigApp.addModule"}}</label>
                    <div class="form-fields">
                        <select name="add.{{pad.index}}">
                            <option value=""></option>
                            {{#each pad.addable as |module|}}
                                <option value="{{module.id}}">{{module.name}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
            {{/if}}
        </fieldset>
    {{/each}}
    {{#if hasGamepads}}
        <p class="hint">{{localize "beaversGamepad.gamepadConfigApp.info"}}</p>
    {{/if}}
</div>
