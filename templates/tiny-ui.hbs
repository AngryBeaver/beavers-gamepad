<div class="tiny-ui-content">
    <div class="drag-me"></div>
    {{#if isIdle}}
        <div class="tiny-ui-idle">
            <div class="tiny-ui-row user-row">
                {{#if user.avatar}}<img src="{{user.avatar}}" alt=""/>{{/if}}
                <span>{{user.name}}</span>
            </div>
            <div class="tiny-ui-row character-row">
                {{#if user.character}}
                    <img src="{{user.character.img}}" alt=""/>
                    <span>{{user.character.name}}</span>
                {{/if}}
            </div>
        </div>
    {{else}}
        <div class="selection">
            <div class="wheel">
                {{#each choices}}
                    <div class="select" data-key="{{this.key}}">
                        {{#if this.img}}<img src="{{this.img}}" alt=""/>{{/if}}
                        <span>{{this.text}}</span>
                    </div>
                {{/each}}
            </div>
        </div>
        <div class="arrows">
            <a class="up"><i class="fa-solid fa-caret-up"></i></a>
            <span class="count"></span>
            <a class="down"><i class="fa-solid fa-caret-down"></i></a>
        </div>
    {{/if}}
</div>
