<div class="gamepad-config-body">
    <p class="gamepad-notice">
        {{localize "beaversGamepad.uiConfigApp.info"}}
    </p>
    {{#each users as |user|}}
        <fieldset>
            <legend>
                {{user.name}}
                <a data-action="removeUser" data-id="{{user.id}}" data-tooltip="beaversGamepad.uiConfigApp.removeUser">
                    <i class="fa-solid fa-trash"></i>
                </a>
            </legend>
            <div class="form-group">
                <label>{{localize "beaversGamepad.uiConfigApp.userPosition"}}</label>
                <div class="form-fields">
                    <select name="{{user.id}}.userPosition">
                        {{selectOptions @root.positionChoices selected=user.userPosition localize=true}}
                    </select>
                </div>
                <p class="hint">{{localize "beaversGamepad.uiConfigApp.userPositionHint"}}</p>
            </div>
            <div class="form-group">
                <label>{{localize "beaversGamepad.uiConfigApp.userPositionPx"}}</label>
                <div class="form-fields">
                    <input type="number" name="{{user.id}}.top" value="{{user.top}}" placeholder="Top" step="1"/>
                    <input type="number" name="{{user.id}}.left" value="{{user.left}}" placeholder="Left" step="1"/>
                    <button type="button" data-action="centerUser" data-id="{{user.id}}"
                            data-tooltip="beaversGamepad.uiConfigApp.userPositionPxCenter">
                        <i class="fa-solid fa-crosshairs"></i>
                    </button>
                </div>
                <p class="hint">{{localize "beaversGamepad.uiConfigApp.userPositionPxHint"}}</p>
            </div>
        </fieldset>
    {{/each}}
    {{#if addable.length}}
        <div class="form-group">
            <label>{{localize "beaversGamepad.uiConfigApp.addUser"}}</label>
            <div class="form-fields">
                <select name="addUser">
                    <option value=""></option>
                    {{#each addable as |user|}}
                        <option value="{{user.id}}">{{user.name}}</option>
                    {{/each}}
                </select>
            </div>
            <p class="hint">{{localize "beaversGamepad.uiConfigApp.addUserHint"}}</p>
        </div>
    {{/if}}
</div>
